# ─── BUILD-TIME (set in GitHub Actions → Settings → Variables) ────────────────
NEXT_PUBLIC_BASE_URL="http://192.168.1.15:5000"
NEXT_PUBLIC_GOOGLE_CAPTCHA_SITE_KEY="site-key-placeholder"
REDIRECT_URL="http://localhost:3000/"
CLIENT_CONFIRM_URL="http://localhost:3000/en/payment-result"
CLIENT_FAILED_URL="http://localhost:3000/en/payment-result"

# ─── RUNTIME (injected at container start via Kubernetes secrets/configmap) ───
KEYCLOAK_CLIENT_ID="client-id"
KEYCLOAK_REALM_NAME="myrealm"
KEYCLOAK_ISSUER="http://localhost:8080/auth/realms/myrealm"

# ─── RUNTIME SECRETS (Kubernetes secrets only, never in CI vars) ──────────────
KEYCLOAK_CLIENT_SECRET="abcbdefghijklmnopqrstuvwxyz123456"
GOOGLE_CAPTCHA_SECRET_KEY="secret-key-placeholder"